# PostgreSQL connection string
DATABASE_URL="postgresql://devnest_app:change_me_strong_password@localhost:5432/devnest_db?schema=public"

# Docker Compose PostgreSQL variables
DB_USER=devnest_app
DB_PASSWORD=change_me_strong_password
DB_NAME=devnest_db

# Redis connection string (optional — falls back to in-memory cache/session when omitted)
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
NODE_ENV=development
SESSION_LIFETIME=3600

# Comma-separated exact CORS origins (no trailing slash, never '*' in production)
CORS_ORIGINS=http://localhost:5173,https://devnest-web-xi.vercel.app

# Cloudinary (required for avatar and project cover photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
